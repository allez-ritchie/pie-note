<?xml version="1.0" encoding="utf-8"?>
<!--
  Open Notebook 常部署在局域网内，使用纯 HTTP（如 http://192.168.31.24:5055）。
  Android 9+ 默认禁止明文流量，而用户可填写任意内网 IP，无法预先枚举域名，
  因此这里对 base-config 开启明文放行；仅限本 App 与内网后端通信，不涉及第三方域名。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
